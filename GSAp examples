//// Third dynatomic polynomial of maps with a 4-periodic critical point

load "DynamicalModularCurves.m";
Qt<t> := PolynomialRing(Rationals());
_<x> := PolynomialRing(Qt);
phi := ((t + t^2 - t^3)*x - t^2)/((t^3 - t^2 - t + 1)*x^2 - (t^3 - t^2 - t)*x - t^2);
f := DynatomicPolynomial(phi,3);
load "GSA.m";
G,_,S := GaloisGroup(f);
Gsubs := SubgroupLattice(G);
e,g,r,u := GSAp(f,G,S,Gsubs:skip:=[2,6,7],g0bound:=10^3);
f,d := SpecializationData(g);
f;
1 - Maximum(d);



